# Contoh konfigurasi. SALIN jadi `.env` lalu isi nilainya (`.env` tidak di-commit).
#
#   cp .env.example .env
#   python scripts/set-password.py     # menulis BOSS_PASSWORD_HASH ke .env (chmod 600)
#
# Catatan: jangan biarkan kunci rahasia berisi nilai kosong. Isi dengan penanda
# yang jelas kalau memang belum diisi, supaya tidak ada yang mengira sudah diisi.

APP_ENV=dev
APP_NAME=Gamis Jumbo CMS
BASE_URL=http://127.0.0.1:8099

# --- Database -------------------------------------------------------------
# Dev/uji (SQLite lokal, nol dampak produksi):
DATABASE_URL=sqlite+pysqlite:///./var/gamisjumbo.db
# Produksi (MariaDB 10.11, user scoped 1 schema) — kredensial asli TIDAK ditulis di repo:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/NAMA_DB?charset=utf8mb4

# --- Keamanan -------------------------------------------------------------
# WAJIB diganti di produksi. Bikin: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=BELUM_DIISI_ganti_dengan_token_urlsafe_48_karakter
COOKIE_SECURE=false

# Akun Boss. Hash bcrypt diisi otomatis oleh scripts/set-password.py
BOSS_USERNAME=boss
BOSS_PASSWORD_HASH=BELUM_DIISI_jalankan_scripts_set-password.py

# --- Batas & path ---------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
IDEMPOTENCY_TTL_HOURS=24
TARGET_MINGGUAN=14
API_HOST=127.0.0.1
API_PORT=8099

# --- Catatan: TIDAK ADA kredensial Telegram di file ini --------------------
# Notifikasi keluar lewat tabel `notification_outbox`; pengirimnya poller @hermes
# memakai bot profil `default`. App ini tidak pernah memegang token bot (D18).
